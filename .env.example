# Banco Postgres (Neon). Use a URL "pooled" do projeto Abastecimento CSN.
DATABASE_URL=

# Segredo para assinar a sessão de login (texto aleatório longo).
AUTH_SECRET=

# Primeiro administrador: criado automaticamente no primeiro acesso ao /login.
# As três são obrigatórias — o login é feito pela matrícula, não pelo e-mail.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_MATRICULA=

# Chaves VAPID para notificações push no navegador (gere com: npx web-push generate-vapid-keys).
# A pública repete em NEXT_PUBLIC_ porque o navegador precisa dela para se inscrever.
VAPID_PUBLIC_KEY=
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# IA — opção 1 (grátis): Google Gemini via endpoint compatível com OpenAI.
# AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# AI_API_KEY=
# AI_MODEL=gemini-2.5-flash
# IA — opção 2: Vercel AI Gateway (no Vercel usa o token OIDC automaticamente).
# AI_GATEWAY_API_KEY=
# AI_MODEL=openai/gpt-4o-mini

# Token para o Excel (Power Query) baixar os dados sem login.
EXPORT_TOKEN=
